# Backend local dev (non-Docker)
# Copy to .env and fill in real values.
# Values must match the db service credentials in root compose.yml.
# Port is 5433 because compose maps host 5433 → container 5432.
KALEKIT_ENV=development
KALEKIT_POSTGRES_USER=kalekit
KALEKIT_POSTGRES_PWD=choose_a_strong_password
KALEKIT_POSTGRES_HOST=127.0.0.1
KALEKIT_POSTGRES_PORT=5433
KALEKIT_POSTGRES_DATABASE=kalekit_dev_db
KALEKIT_JWT_SECRET_KEY=change_me_in_production
# `iss` claim on access tokens; tokens with a different issuer are rejected.
# Set a distinct value per environment (e.g. kalekit-staging).
KALEKIT_JWT_ISSUER=kalekit
KALEKIT_CORS_ORIGINS=https://kalekit.dev
# Password length rule, in characters. Enforced when a password is set
# (register); login only enforces the maximum.
KALEKIT_PASSWORD_MIN_LENGTH=12
KALEKIT_PASSWORD_MAX_LENGTH=128
# Host header allow-list (comma-separated); requests for any other Host get a 400
KALEKIT_ALLOWED_HOSTS=localhost,127.0.0.1

# APIs
GEMINI_API_KEY=your_gemini_api_key_here

