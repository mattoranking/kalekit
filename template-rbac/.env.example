# ──────────────────────────────────────────────
# Copy to .env and fill in real values
# Docker Compose reads .env automatically.
# ──────────────────────────────────────────────

# Database credentials (shared by db service + backend)
KALEKIT_POSTGRES_USER=kalekit
KALEKIT_POSTGRES_PASSWORD=choose_a_strong_password
KALEKIT_POSTGRES_DB=kalekit_dev_db

# Backend
KALEKIT_ENV=development
KALEKIT_JWT_SECRET_KEY=change_me_in_production
KALEKIT_CORS_ORIGINS=https://kalekit.dev
# Host header allow-list for the API (comma-separated); requests for any other Host get a 400
KALEKIT_ALLOWED_HOSTS=api.kalekit.dev,localhost,127.0.0.1

# APIs
GEMINI_API_KEY=your_gemini_api_key_here
