KALEKIT_ENV=testing
DEBUG=false

# See kalekit/config.py -- off by default in tests, a dedicated test
# module opts back in with tight thresholds.
KALEKIT_RATE_LIMIT_ENABLED=false

KALEKIT_POSTGRES_USER=kalekit
KALEKIT_POSTGRES_PWD=kalekit
KALEKIT_POSTGRES_HOST=127.0.0.1
KALEKIT_POSTGRES_PORT=5434
KALEKIT_POSTGRES_DATABASE=kalekit_test_db

# A dedicated Redis index: the test suite flushes it before every test,
# so it must never be db 0 (the dev app's).
KALEKIT_REDIS_URL=redis://localhost:6379/15
